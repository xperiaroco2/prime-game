[sub_resource type="Resource" id="Window_script"]
script = ExtResource("3_script")

[sub_resource type="Resource" id="Ready"]
script = ExtResource("5_ready")

[sub_resource type="Resource" id="Wait_round"]
script = ExtResource("6_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Wait_windows"]
script = ExtResource("11_wait")
seconds = 9.0

[sub_resource type="Resource" id="Target_package"]
script = ExtResource("7_target")
kind = 2
item_kind = &"package"

[sub_resource type="Resource" id="Walk_to_package"]
script = ExtResource("8_walk_to")
target = SubResource("Target_package")
stop_m = 1.0

[sub_resource type="Resource" id="Pick_up_package"]
script = ExtResource("9_pick_up")
target = SubResource("Target_package")

[sub_resource type="Resource" id="Wait_carry"]
script = ExtResource("11_wait")
seconds = 1.0

[sub_resource type="Resource" id="Target_player1"]
script = ExtResource("7_target")
kind = 3

[sub_resource type="Resource" id="Walk_to_player1"]
script = ExtResource("8_walk_to")
target = SubResource("Target_player1")
stop_m = 2.0

[sub_resource type="Resource" id="Wait_end"]
script = ExtResource("11_wait")
seconds = 20.0

[sub_resource type="Resource" id="Bot3_script"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Ready"), SubResource("Wait_round"), SubResource("Wait_windows"), SubResource("Walk_to_package"), SubResource("Pick_up_package"), SubResource("Wait_carry"), SubResource("Walk_to_player1"), SubResource("Wait_end")])

[resource]
script = ExtResource("2_scenario")
mode = ExtResource("1_mode")
bots = 3
scripts = Array[ExtResource("3_script")]([SubResource("Window_script"), SubResource("Window_script"), SubResource("Bot3_script")])
expected_ends = Array[StringName]([&"none"])
