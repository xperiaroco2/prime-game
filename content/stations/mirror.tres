[sub_resource type="Resource" id="Place_at"]
script = ExtResource("5_at_station")

[sub_resource type="Resource" id="Place_sight"]
script = ExtResource("6_in_sight")

[sub_resource type="Resource" id="Place_free"]
script = ExtResource("7_free")

[sub_resource type="Resource" id="Place_cooldown"]
script = ExtResource("8_cooldown")
key = &"mirror_place"
seconds = 0.5

[sub_resource type="Resource" id="Place_use"]
script = ExtResource("9_use")

[sub_resource type="Resource" id="Rule_place"]
script = ExtResource("2_rule")
trigger = &"Interact"
conditions = Array[ExtResource("3_condition")]([SubResource("Place_at"), SubResource("Place_sight"), SubResource("Place_free"), SubResource("Place_cooldown")])
effects = Array[ExtResource("4_effect")]([SubResource("Place_use")])

[resource]
script = ExtResource("1_station")
id = &"mirror"
spawn_tag = &"mirror"
radius_m = 0.6
height_m = 2.5
palette = null
actions = Array[ExtResource("2_rule")]([SubResource("Rule_place")])
metadata/note = "A place at the lobby's mirror (GDD 3 \"The mirror\", #1394): one station per `mirror` marker of the hall (StationTicks every_marker); E at a free place takes it, which lets its player change the body colour there (SetProfile), E again gives it up, and walking off gives it up. In M8 only the colour changes (the M8 sit-down, 2026-11-08). The number of places (3 on the greybox mirror, 0.65 m apart), the radius (0.6 m), the height (the mirror's 2.5 m) and the Cooldown (0.5 s, the pinball's) are provisional, not a decision."
