[gd_resource type="Resource" script_class="StationKind" format=3 uid="uid://cpi8gb2tf3s4u"]

[ext_resource type="Script" uid="uid://bdcmbmmn1hkcr" path="res://core/content/station_kind.gd" id="1_station"]
[ext_resource type="Script" uid="uid://cy0046m38wqxk" path="res://core/content/rule.gd" id="2_rule"]
[ext_resource type="Script" uid="uid://dsggw51c5ve1q" path="res://core/content/condition.gd" id="3_condition"]
[ext_resource type="Script" uid="uid://cxlhc27do1bp5" path="res://core/content/rule_effect.gd" id="4_effect"]
[ext_resource type="Script" uid="uid://oy01r2qafwmr" path="res://core/tasks/at_station.gd" id="5_at_station"]
[ext_resource type="Script" uid="uid://b82d0e0mv2cse" path="res://core/tasks/station_in_sight.gd" id="6_in_sight"]
[ext_resource type="Script" uid="uid://bo5h5m5ga21p6" path="res://core/combat/cooldown.gd" id="7_cooldown"]
[ext_resource type="Script" uid="uid://d1n63fl42eis0" path="res://core/tasks/toggle_station.gd" id="8_toggle"]

[sub_resource type="Resource" id="Toggle_at"]
script = ExtResource("5_at_station")

[sub_resource type="Resource" id="Toggle_sight"]
script = ExtResource("6_in_sight")

[sub_resource type="Resource" id="Toggle_cooldown"]
script = ExtResource("7_cooldown")
key = &"toggle"
seconds = 0.25

[sub_resource type="Resource" id="Toggle_flip"]
script = ExtResource("8_toggle")

[sub_resource type="Resource" id="Rule_toggle"]
script = ExtResource("2_rule")
trigger = &"Interact"
conditions = Array[ExtResource("3_condition")]([SubResource("Toggle_at"), SubResource("Toggle_sight"), SubResource("Toggle_cooldown")])
effects = Array[ExtResource("4_effect")]([SubResource("Toggle_flip")])

[resource]
script = ExtResource("1_station")
id = &"wine_rack_inside"
spawn_tag = &"wine_rack_inside"
radius_m = 1.5
height_m = 2.0
palette = null
actions = Array[ExtResource("2_rule")]([SubResource("Rule_toggle")])
toggle_key = &"bookcase"
metadata/note = "The secret stair's bottom landing, behind the wine rack: opens the passage from inside (estate-map 5b, no dead ends). The radius, the height, the Cooldown seconds (the tap's 1.5 m, 2 m, 0.25 s) and the prompt (the id until the UI deck has station.wine_rack_inside) are placeholders, not a decision (#1459)."
