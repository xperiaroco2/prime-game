[resource]
script = ExtResource("1_mode")
min_players = 3
max_players = 3
settings = Array[ExtResource("4_setting")]([SubResource("Setting_tasks"), SubResource("Setting_banned_task_types"), SubResource("Setting_packages"), SubResource("Setting_knives")])
player_rules = SubResource("PlayerRules_tutorial")
sides = Array[ExtResource("6_side")]([SubResource("Side_crew")])
roles = Array[ExtResource("15_role")]([ExtResource("30_crew")])
item_kinds = Array[ExtResource("3_item_kind")]([ExtResource("25_package"), ExtResource("33_knife")])
maps = PackedStringArray("res://levels/tutorial/tutorial.tscn")
actions = Array[ExtResource("2_rule")]([SubResource("Rule_pick_up"), SubResource("Rule_put_down"), SubResource("Rule_raise"), SubResource("Rule_stop_raise"), SubResource("Rule_swap"), SubResource("Rule_next_stage")])
task_types = Array[ExtResource("17_task_type")]([ExtResource("27_delivery")])
phases = Array[ExtResource("7_phase")]([SubResource("Phase_gather"), SubResource("Phase_loading"), SubResource("Phase_lessons"), SubResource("Phase_raise_stage"), SubResource("Phase_death_stage")])
first_phase = &"gather"
transitions = Array[ExtResource("10_row")]([SubResource("Row_gather_all_ready"), SubResource("Row_loading_all_loaded"), SubResource("Row_lessons_next"), SubResource("Row_raise_stage_next")])
