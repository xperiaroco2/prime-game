[sub_resource type="Resource" id="Row_end_back"]
script = ExtResource("7_row")
from = &"end"
outcome = &"back"
to = &"lobby"
actions = Array[ExtResource("14_effect")]([SubResource("Reset_match"), SubResource("Place_lobby_player")])

[resource]
script = ExtResource("1_mode")
min_players = 1
max_players = 10
settings = Array[ExtResource("2_setting")]([SubResource("Setting_match_duration"), SubResource("Setting_tasks_per_player"), SubResource("Setting_subtasks_per_task"), SubResource("Setting_dissidents"), SubResource("Setting_knives")])
player_rules = SubResource("PlayerRules_base")
sides = Array[ExtResource("4_side")]([SubResource("Side_crew"), SubResource("Side_dissidents")])
lobby_level = "res://levels/lobby/lobby.tscn"
maps = PackedStringArray("res://levels/greybox/greybox.tscn")
phases = Array[ExtResource("5_phase")]([SubResource("Phase_lobby"), SubResource("Phase_countdown"), SubResource("Phase_loading"), SubResource("Phase_round"), SubResource("Phase_end")])
first_phase = &"lobby"
transitions = Array[ExtResource("7_row")]([SubResource("Row_lobby_all_ready"), SubResource("Row_countdown_cancelled"), SubResource("Row_countdown_done"), SubResource("Row_loading_all_loaded"), SubResource("Row_round_won"), SubResource("Row_end_back")])
