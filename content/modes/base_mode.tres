from = 1

[sub_resource type="Resource" id="Accept_lobby_move"]
script = ExtResource("6_accept")
intent = &"MoveClaim"
from = 4

[sub_resource type="Resource" id="Accept_lobby_ready"]
script = ExtResource("6_accept")
intent = &"SetReady"
from = 2

[sub_resource type="Resource" id="Accept_lobby_settings"]
script = ExtResource("6_accept")
intent = &"ChangeSettings"
from = 16

[sub_resource type="Resource" id="Phase_lobby"]
script = ExtResource("5_phase")
id = &"lobby"
phase_class = ExtResource("9_lobby")
accepts = Array[ExtResource("6_accept")]([SubResource("Accept_lobby_hello"), SubResource("Accept_lobby_move"), SubResource("Accept_lobby_ready"), SubResource("Accept_lobby_settings")])
level = 1
snapshots = true

[sub_resource type="Resource" id="Accept_countdown_hello"]
script = ExtResource("6_accept")
intent = &"Hello"
from = 1

[sub_resource type="Resource" id="Accept_countdown_move"]
script = ExtResource("6_accept")
intent = &"MoveClaim"
from = 4

[sub_resource type="Resource" id="Accept_countdown_ready"]
script = ExtResource("6_accept")
intent = &"SetReady"
from = 2

[sub_resource type="Resource" id="Phase_countdown"]
script = ExtResource("5_phase")
id = &"countdown"
phase_class = ExtResource("10_countdown")
settings = Dictionary[StringName, float]({
&"seconds": 5.0
})
accepts = Array[ExtResource("6_accept")]([SubResource("Accept_countdown_hello"), SubResource("Accept_countdown_move"), SubResource("Accept_countdown_ready")])
level = 1
snapshots = true

[sub_resource type="Resource" id="Accept_loading_ack"]
