[sub_resource type="Resource" id="Row_pregame_done"]
script = ExtResource("7_row")
from = &"pregame"
outcome = &"pregame_done"
to = &"round"
actions = Array[ExtResource("14_effect")]([SubResource("Start_clock")])

[sub_resource type="Resource" id="End_match"]
script = ExtResource("64_end_match")

[sub_resource type="Resource" id="Row_round_won"]
script = ExtResource("7_row")
from = &"round"
outcome = &"won"
to = &"end"
actions = Array[ExtResource("14_effect")]([SubResource("End_match"), SubResource("Offers_end")])

[sub_resource type="Resource" id="Reset_match"]
script = ExtResource("21_reset")

[sub_resource type="Resource" id="Place_lobby_player"]
script = ExtResource("8_place")
tag = &"lobby_player"

[sub_resource type="Resource" id="Row_end_back"]
script = ExtResource("7_row")
from = &"end"
outcome = &"back"
to = &"lobby"
actions = Array[ExtResource("14_effect")]([SubResource("Reset_match"), SubResource("Place_lobby_player")])

