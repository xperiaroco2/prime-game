[sub_resource type="Resource" id="Rule_take"]
script = ExtResource("2_rule")
trigger = &"Interact"
conditions = Array[ExtResource("3_condition")]([SubResource("Take_on_ground"), SubResource("Take_in_reach"), SubResource("Take_in_sight"), SubResource("Take_cooldown")])
effects = Array[ExtResource("4_effect")]([SubResource("Take_give")])

[resource]
script = ExtResource("1_kind")
