[sub_resource type="Resource" id="Ready"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Round"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Let_it_come"]
script = ExtResource("8_wait")
seconds = 8.0

[sub_resource type="Resource" id="Bot_two"]
script = ExtResource("5_target")
kind = 3
bot = 2

[sub_resource type="Resource" id="Punch"]
script = ExtResource("10_use")
towards = SubResource("Bot_two")

[sub_resource type="Resource" id="Breathe"]
script = ExtResource("8_wait")
seconds = 1.7

[sub_resource type="Resource" id="Expect_down"]
script = ExtResource("11_expect")
event = &"KnockedDown"
fields = {
"peer": 2
}
within_s = 3.0

[sub_resource type="Resource" id="Puncher"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Ready"), SubResource("Round"), SubResource("Let_it_come"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Breathe"), SubResource("Punch"), SubResource("Expect_down")])

[sub_resource type="Resource" id="Bot_one"]
script = ExtResource("5_target")
kind = 3

[sub_resource type="Resource" id="Come_close"]
script = ExtResource("9_walk")
target = SubResource("Bot_one")
stop_m = 1.0

[sub_resource type="Resource" id="Wait_down"]
script = ExtResource("7_wait_for")
event = &"KnockedDown"
fields = {
"peer": 2
}

[sub_resource type="Resource" id="Target"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Ready"), SubResource("Round"), SubResource("Come_close"), SubResource("Wait_down")])

[sub_resource type="Resource" id="Witness"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Ready"), SubResource("Round"), SubResource("Wait_down")])

[resource]
script = ExtResource("2_scen")
mode = ExtResource("1_mode")
session_seed = 158700000001
bots = 3
scripts = Array[ExtResource("3_script")]([SubResource("Puncher"), SubResource("Target"), SubResource("Witness")])
expected_ends = Array[StringName]([&"none"])
time_limit_s = 90.0
metadata/note = "The M8 release's hits (#1587, GDD 3 \"The M8 release\", \"Melee: any item hits\"): in the shipped base mode's Round bot 2 walks up to bot 1, so it faces it, and bot 1 punches it with the bare fist 20 times, 1.7 s apart (a swing costs 25 stamina, 15 come back a second): 20 front hits of 5 take its 100 health, and the 20th knocks it down. Bot 3 only watches: every swing is public (Swung), the damage the victim's alone (the leak check compares all three views)."
