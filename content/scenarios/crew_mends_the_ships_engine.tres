[gd_resource type="Resource" script_class="BotScenario" format=3]

[ext_resource type="Resource" path="res://content/modes/base_mode.tres" id="1_mode"]
[ext_resource type="Script" path="res://core/content/scenario/never_event.gd" id="2_never"]
[ext_resource type="Script" path="res://core/content/scenario/bot_scenario.gd" id="3_scenario"]
[ext_resource type="Script" path="res://core/content/scenario/bot_script.gd" id="4_script"]
[ext_resource type="Script" path="res://core/content/scenario/scenario_step.gd" id="5_step"]
[ext_resource type="Script" path="res://core/content/scenario/step_ready.gd" id="6_ready"]
[ext_resource type="Script" path="res://core/content/scenario/step_wait_for.gd" id="7_wait_for"]
[ext_resource type="Script" path="res://core/content/scenario/step_mend_engine.gd" id="8_mend"]
[ext_resource type="Script" path="res://core/content/scenario/step_expect.gd" id="9_expect"]

[sub_resource type="Resource" id="Resource_ready1"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Resource_round1"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Resource_end1"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "end"
}

[sub_resource type="Resource" id="Resource_human"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Resource_ready1"), SubResource("Resource_round1"), SubResource("Resource_end1")])

[sub_resource type="Resource" id="Resource_ready2"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Resource_round2"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Resource_mend2"]
script = ExtResource("8_mend")
share = 0
of = 3
start = true
boarding = PackedVector3Array(116, 0, 58.5, 116, 1.2, 64.5)

[sub_resource type="Resource" id="Resource_gills"]
script = ExtResource("9_expect")
event = &"GillFlipped"

[sub_resource type="Resource" id="Resource_alien2"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Resource_ready2"), SubResource("Resource_round2"), SubResource("Resource_mend2"), SubResource("Resource_gills")])

[sub_resource type="Resource" id="Resource_ready3"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Resource_round3"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Resource_mend3"]
script = ExtResource("8_mend")
share = 1
of = 3
boarding = PackedVector3Array(116, 0, 58.5, 116, 1.2, 64.5)

[sub_resource type="Resource" id="Resource_breakers"]
script = ExtResource("9_expect")
event = &"BreakerChain"
fields = {
"next": 1
}

[sub_resource type="Resource" id="Resource_alien3"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Resource_ready3"), SubResource("Resource_round3"), SubResource("Resource_mend3"), SubResource("Resource_breakers")])

[sub_resource type="Resource" id="Resource_ready4"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Resource_round4"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Resource_mend4"]
script = ExtResource("8_mend")
share = 2
of = 3
boarding = PackedVector3Array(116, 0, 58.5, 116, 1.2, 64.5)

[sub_resource type="Resource" id="Resource_crystal"]
script = ExtResource("9_expect")
event = &"CrystalChanged"

[sub_resource type="Resource" id="Resource_alien4"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Resource_ready4"), SubResource("Resource_round4"), SubResource("Resource_mend4"), SubResource("Resource_crystal")])

[sub_resource type="Resource" id="Resource_no_blast"]
script = ExtResource("2_never")
event = &"EngineBlast"

[resource]
script = ExtResource("3_scenario")
mode = ExtResource("1_mode")
map = "res://levels/estate/estate.tscn"
session_seed = 149800000001
bots = 4
forced_roles = Dictionary[int, StringName]({
1: &"dissident"
})
scripts = Array[ExtResource("4_script")]([SubResource("Resource_human"), SubResource("Resource_alien2"), SubResource("Resource_alien3"), SubResource("Resource_alien4")])
expected_ends = Array[StringName]([&"crew"])
time_limit_s = 240.0
never = Array[ExtResource("2_never")]([SubResource("Resource_no_blast")])
