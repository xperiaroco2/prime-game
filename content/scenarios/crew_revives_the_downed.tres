[sub_resource type="Resource" id="Revived_3"]
script = ExtResource("13_expect")
event = &"Revived"
fields = {
"peer": 3
}

[sub_resource type="Resource" id="B2_script"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Ready"), SubResource("Wait_round"), SubResource("Wait_knocked_down_3"), SubResource("Walk_to_bot3"), SubResource("B2_raise_bot3"), SubResource("Revived_3"), SubResource("Wait_ended")])

[sub_resource type="Resource" id="Wait_raise_started"]
script = ExtResource("7_wait_for")
event = &"RaiseStarted"
fields = {
"raiser": 2,
"target": 3
}

[sub_resource type="Resource" id="B3_revive_health"]
script = ExtResource("13_expect")
event = &"SelfStatus"
fields = {
"health": 50000
}
