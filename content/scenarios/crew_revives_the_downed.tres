[sub_resource type="Resource" id="Never_died"]
script = ExtResource("2_never")
event = &"Died"

[sub_resource type="Resource" id="Never_raise_stopped"]
script = ExtResource("2_never")
event = &"RaiseStopped"

[sub_resource type="Resource" id="Ready"]
script = ExtResource("6_ready")

[sub_resource type="Resource" id="Wait_round"]
script = ExtResource("7_wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="Target_knife"]
script = ExtResource("9_target")
kind = 2
item_kind = &"knife"

[sub_resource type="Resource" id="B1_walk_to_knife"]
