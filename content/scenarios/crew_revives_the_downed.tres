1: &"dissident"
})
scripts = Array[ExtResource("4_script")]([SubResource("B1_script"), SubResource("B2_script"), SubResource("B3_script")])
expected_ends = Array[StringName]([&"dissidents"])
clock_s = 30
time_limit_s = 60.0
never = Array[ExtResource("2_never")]([SubResource("Never_died"), SubResource("Never_raise_stopped")])
