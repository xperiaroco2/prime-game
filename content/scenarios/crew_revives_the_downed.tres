[sub_resource type="Resource" id="B3_script"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Ready"), SubResource("Wait_round"), SubResource("Wait_knocked_down_3"), SubResource("Wait_raise_started"), SubResource("Wait_revived_3"), SubResource("B3_revive_health"), SubResource("Wait_ended")])

[resource]
script = ExtResource("3_scenario")
mode = ExtResource("1_mode")
session_seed = 422000000004
bots = 3
settings = Dictionary[StringName, int]({
&"tasks": 1
})
id_sets = Dictionary[StringName, PackedStringArray]({
&"banned_task_types": PackedStringArray("hold_the_zone")
})
