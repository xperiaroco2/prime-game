[sub_resource type="Resource" id="B1_pick_up_knife"]
script = ExtResource("10_pick_up")
target = SubResource("Target_knife")

[sub_resource type="Resource" id="Target_bot3"]
script = ExtResource("9_target")
kind = 3
bot = 3

[sub_resource type="Resource" id="Walk_to_bot3"]
script = ExtResource("8_walk_to")
target = SubResource("Target_bot3")
stop_m = 1.0

[sub_resource type="Resource" id="B1_hit"]
script = ExtResource("11_use")
towards = SubResource("Target_bot3")

[sub_resource type="Resource" id="Wait_cooldown"]
script = ExtResource("12_wait")
seconds = 0.6

[sub_resource type="Resource" id="Knocked_down_3"]
script = ExtResource("13_expect")
event = &"KnockedDown"
fields = {
"peer": 3
}

[sub_resource type="Resource" id="Wait_revived_3"]
script = ExtResource("7_wait_for")
event = &"Revived"
fields = {
"peer": 3
}

[sub_resource type="Resource" id="Wait_ended"]
script = ExtResource("7_wait_for")
event = &"MatchEnded"
fields = {
"side": "dissidents"
}

[sub_resource type="Resource" id="B1_script"]
script = ExtResource("4_script")
steps = Array[ExtResource("5_step")]([SubResource("Ready"), SubResource("Wait_round"), SubResource("B1_walk_to_knife"), SubResource("B1_pick_up_knife"), SubResource("Walk_to_bot3"), SubResource("B1_hit"), SubResource("Wait_cooldown"), SubResource("B1_hit"), SubResource("Knocked_down_3"), SubResource("Wait_revived_3"), SubResource("Wait_ended")])

[sub_resource type="Resource" id="Wait_knocked_down_3"]
script = ExtResource("7_wait_for")
event = &"KnockedDown"
fields = {
"peer": 3
}

[sub_resource type="Resource" id="B2_raise_bot3"]
script = ExtResource("14_raise")
