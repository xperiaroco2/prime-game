[sub_resource type="Resource" id="ready_1"]
script = ExtResource("ready")

[sub_resource type="Resource" id="wait_for_2"]
script = ExtResource("wait_for")
event = &"PhaseChanged"
fields = {
"phase": "round"
}

[sub_resource type="Resource" id="wait_for_3"]
script = ExtResource("wait_for")
event = &"MatchEnded"
fields = {
"side": "crew"
}

[sub_resource type="Resource" id="script_6"]
script = ExtResource("script")
steps = Array[ExtResource("step")]([SubResource("ready_1"), SubResource("wait_for_2"), SubResource("wait_for_3")])

[sub_resource type="Resource" id="target_5"]
script = ExtResource("target")
kind = 5
station_kind = &"zone"

[sub_resource type="Resource" id="walk_to_7"]
script = ExtResource("walk_to")
target = SubResource("target_5")
sprint = true
stop_m = 0.0

[sub_resource type="Resource" id="expect_8"]
script = ExtResource("expect")
event = &"ZoneProgress"
fields = {
"counting": true
}
within_s = 1.0

[sub_resource type="Resource" id="wait_for_9"]
script = ExtResource("wait_for")
event = &"TaskProgress"
fields = {
"done": 1,
"total": 1
}

[sub_resource type="Resource" id="expect_4"]
script = ExtResource("expect")
event = &"MatchEnded"
fields = {
"side": "crew"
}
within_s = 1.0

[sub_resource type="Resource" id="script_10"]
script = ExtResource("script")
steps = Array[ExtResource("step")]([SubResource("ready_1"), SubResource("wait_for_2"), SubResource("walk_to_7"), SubResource("expect_8"), SubResource("wait_for_9"), SubResource("expect_4")])

[resource]
script = ExtResource("scenario")
mode = ExtResource("mode")
session_seed = 649000000003
bots = 2
settings = Dictionary[StringName, int]({
&"tasks": 1
})
id_sets = Dictionary[StringName, PackedStringArray]({
&"banned_task_types": PackedStringArray("delivery")
})
forced_roles = Dictionary[int, StringName]({
1: &"crew",
2: &"dissident"
})
scripts = Array[ExtResource("script")]([SubResource("script_6"), SubResource("script_10")])
expected_ends = Array[StringName]([&"crew"])
time_limit_s = 45.0
