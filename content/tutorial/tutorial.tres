[sub_resource type="Resource" id="Seen_moved"]
script = ExtResource("8_client_seen")
signal_name = &"moved"
amount = 1.0

[sub_resource type="Resource" id="Step_move"]
script = ExtResource("3_step")
title_key = &"tutorial.step.move.title"
keys = Array[StringName]([&"move_forward", &"move_left", &"move_back", &"move_right", &"sprint", &"jump"])
triggers = Array[ExtResource("4_trigger")]([SubResource("Seen_moved")])

[sub_resource type="Resource" id="Lesson_move"]
script = ExtResource("2_lesson")
list_key = &"tutorial.list.move"
steps = Array[ExtResource("3_step")]([SubResource("Step_move")])

[sub_resource type="Resource" id="Kind_package"]
script = ExtResource("11_item_kind_is")
kind = &"package"

[sub_resource type="Resource" id="Event_picked_up"]
script = ExtResource("7_event_seen")
event = &"ItemPickedUp"
fields = {
"peer": &"own"
}

[sub_resource type="Resource" id="Step_pick_up"]
