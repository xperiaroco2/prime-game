[resource]
script = ExtResource("1_car_repair")
car = SubResource("StationKind_car")
lift_panel = SubResource("StationKind_lift_panel")
bins = Array[ExtResource("2_station")]([SubResource("StationKind_part_bin_1"), SubResource("StationKind_part_bin_2"), SubResource("StationKind_part_bin_3")])
picture = SubResource("StationKind_part_picture")
parts = Array[ExtResource("14_item_kind")]([ExtResource("15_green"), ExtResource("16_blue"), ExtResource("17_yellow")])
rise_seconds = 2.0
half_width_m = 1.0
clearance_m = 1.4
id = &"car_repair"
display_name = "Repair the car"
description = "Take the part shown on the garage wall from the shelf in storage, then fit it under the car while someone holds the lift."
maps = PackedStringArray("res://levels/house/house.tscn")
subtasks_setting = &"car_parts"
