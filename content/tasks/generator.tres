trigger = &"Interact"
conditions = Array[ExtResource("4_condition")]([SubResource("Switch_one_handed"), SubResource("Switch_at_station"), SubResource("Switch_in_sight"), SubResource("Switch_usable")])
effects = Array[ExtResource("5_effect")]([SubResource("Switch_use")])

[sub_resource type="Resource" id="StationKind_switch"]
script = ExtResource("2_station")
id = &"switch"
spawn_tag = &"switch"
radius_m = 2.0
height_m = 2.0
palette = PackedColorArray()
actions = Array[ExtResource("3_rule")]([SubResource("Rule_use_switch")])

[resource]
script = ExtResource("1_generator")
generator = SubResource("StationKind_generator")
switch = SubResource("StationKind_switch")
switches = 4
seconds = 60.0
id = &"generator"
display_name = "Charge the generator"
description = "Switch on every active switch, then press the generator's button to charge it."
maps = PackedStringArray("res://levels/house/house.tscn")
subtasks_setting = &"switches"
