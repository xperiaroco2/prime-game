[sub_resource type="Resource" id="Generator_at_station"]
script = ExtResource("7_at_station")

[sub_resource type="Resource" id="Generator_in_sight"]
script = ExtResource("8_in_sight")

[sub_resource type="Resource" id="Generator_usable"]
script = ExtResource("9_usable")

[sub_resource type="Resource" id="Generator_use"]
script = ExtResource("10_use_station")

[sub_resource type="Resource" id="Rule_use_generator"]
script = ExtResource("3_rule")
trigger = &"Interact"
conditions = Array[ExtResource("4_condition")]([SubResource("Generator_one_handed"), SubResource("Generator_at_station"), SubResource("Generator_in_sight"), SubResource("Generator_usable")])
effects = Array[ExtResource("5_effect")]([SubResource("Generator_use")])

[sub_resource type="Resource" id="StationKind_generator"]
script = ExtResource("2_station")
id = &"generator"
spawn_tag = &"generator"
radius_m = 2.0
height_m = 2.0
palette = PackedColorArray()
actions = Array[ExtResource("3_rule")]([SubResource("Rule_use_generator")])

[sub_resource type="Resource" id="Switch_one_handed"]
script = ExtResource("6_one_handed")

[sub_resource type="Resource" id="Switch_at_station"]
