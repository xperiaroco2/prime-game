[sub_resource type="Resource" id="Console_use"]
script = ExtResource("10_use_station")

[sub_resource type="Resource" id="Rule_use_engine_console"]
script = ExtResource("3_rule")
trigger = &"Interact"
conditions = Array[ExtResource("4_condition")]([SubResource("Console_one_handed"), SubResource("Console_at_station"), SubResource("Console_in_sight"), SubResource("Console_usable")])
effects = Array[ExtResource("5_effect")]([SubResource("Console_use")])

[sub_resource type="Resource" id="StationKind_engine_console"]
script = ExtResource("2_station")
id = &"engine_console"
spawn_tag = &"engine_console"
radius_m = 2.0
height_m = 2.0
palette = PackedColorArray()
actions = Array[ExtResource("3_rule")]([SubResource("Rule_use_engine_console")])

[resource]
script = ExtResource("1_engine")
start = SubResource("StationKind_engine_console")
kinds = Array[ExtResource("14_problem_kind")]([ExtResource("11_gills"), ExtResource("12_breakers"), ExtResource("13_crystal")])
stage_problems = PackedInt32Array(2, 4, 6)
stage_seconds = 30.0
id = &"engine"
display_name = "Ship's engine"
description = "Press start on the console in the ship's hall, then fix each problem before its timer runs out."
maps = PackedStringArray("res://levels/estate/estate.tscn")
subtasks_setting = &"engine_stages"
