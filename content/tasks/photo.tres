[resource]
script = ExtResource("1_photo")
camera = SubResource("StationKind_camera")
photo_spot = SubResource("StationKind_photo_spot")
film_box = SubResource("StationKind_film_box")
printer = SubResource("StationKind_printer")
board = SubResource("StationKind_photo_board")
film = ExtResource("12_film")
photo = ExtResource("13_photo")
frames_per_film = 5
fov_deg = 50.0
aspect = 1.3333334
range_m = 10.0
id = &"photo"
display_name = "Photography"
description = "Load a film into the camera, photograph a player on the spot, print the film, and hang the photos on the board: each one with a person in it counts."
maps = PackedStringArray("res://levels/house/house.tscn")
subtasks_setting = &"photos"
