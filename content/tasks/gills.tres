[sub_resource type="Resource" id="Gill_use"]
script = ExtResource("10_use_station")

[sub_resource type="Resource" id="Rule_use_gill_button"]
script = ExtResource("3_rule")
trigger = &"Interact"
conditions = Array[ExtResource("4_condition")]([SubResource("Gill_one_handed"), SubResource("Gill_at_station"), SubResource("Gill_in_sight"), SubResource("Gill_usable")])
effects = Array[ExtResource("5_effect")]([SubResource("Gill_use")])

[sub_resource type="Resource" id="StationKind_gill_button"]
script = ExtResource("2_station")
id = &"gill_button"
spawn_tag = &"gill_button"
radius_m = 2.0
height_m = 2.0
palette = PackedColorArray()
actions = Array[ExtResource("3_rule")]([SubResource("Rule_use_gill_button")])

[resource]
script = ExtResource("1_kind")
id = &"gills"
seconds = 10.0
site = SubResource("StationKind_gill_button")
