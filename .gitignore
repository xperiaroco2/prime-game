# Godot 4+ specific ignores
.godot/
/android/

# GdUnit4 reports when tests run from the editor (the runner writes to tools/out/gdunit instead)
/reports/

# Claude Code: personal settings and agent worktrees
.claude/settings.local.json
.claude/worktrees/

# Task runner output (screenshots, API dumps, logs) and Python caches
tools/out/
# Agents' temporary files that must live under res:// (a probe test); full check and test runs skip it
/tests/scratch/
__pycache__/

# JetBrains Rider: personal files; shared run configurations may be un-ignored deliberately
.idea/

# The runner's per-worktree user:// (tools/runner/common.py ensure_user_dir, #182); the main checkout has none
/override.cfg
