#!/bin/sh
# Block direct pushes to main, any non-fast-forward (force) update, and any remote branch deletion.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "pre-push: direct push to main is blocked; open a PR" >&2; status=1
  fi
  if [ "$local_oid" = "$zero" ]; then
    echo "pre-push: deleting $remote_ref is blocked" >&2; status=1; continue
  fi
  if [ "$remote_oid" != "$zero" ] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    echo "pre-push: non-fast-forward (force) update of $remote_ref is blocked" >&2; status=1
  fi
done
exit $status
