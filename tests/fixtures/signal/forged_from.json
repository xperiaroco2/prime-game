{
  "about": "A joiner's \"from\" and a host's \"ice_servers\" and \"from\" are dropped: the host hears the service's number for the joiner, the joiner the service's ICE servers.",
  "config": {
    "ice_servers": [
      {
        "urls": [
          "stun:stun.cloudflare.com:3478"
        ]
      }
    ],
    "codes": [
      "ABCDEF"
    ]
  },
  "steps": [
    {
      "open": "host"
    },
    {
      "from": "host",
      "send": {
        "t": "open",
        "v": 1,
        "protocol": 7,
        "content": "0123456789abcdef",
        "max": 9
      },
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "room",
            "v": 1,
            "code": "ABCDEF",
            "ice_servers": [
              {
                "urls": [
                  "stun:stun.cloudflare.com:3478"
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "open": "j1"
    },
    {
      "from": "j1",
      "send": {
        "t": "join",
        "v": 1,
        "code": "ABCDEF"
      },
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "found",
            "v": 1,
            "protocol": 7,
            "content": "0123456789abcdef"
          }
        },
        {
          "to": "host",
          "msg": {
            "t": "join",
            "v": 1,
            "from": 1
          }
        }
      ]
    },
    {
      "open": "j2"
    },
    {
      "from": "j2",
      "send": {
        "t": "join",
        "v": 1,
        "code": "ABCDEF"
      },
      "expect": [
        {
          "to": "j2",
          "msg": {
            "t": "found",
            "v": 1,
            "protocol": 7,
            "content": "0123456789abcdef"
          }
        },
        {
          "to": "host",
          "msg": {
            "t": "join",
            "v": 1,
            "from": 2
          }
        }
      ]
    },
    {
      "from": "j1",
      "send": {
        "t": "answer",
        "v": 1,
        "sdp": "v=0\r\no=- 3 4 IN IP4 127.0.0.1\r\ns=-\r\n",
        "from": 2
      },
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "answer",
            "v": 1,
            "sdp": "v=0\r\no=- 3 4 IN IP4 127.0.0.1\r\ns=-\r\n",
            "from": 1
          }
        }
      ]
    },
    {
      "from": "j1",
      "send": {
        "t": "candidate",
        "v": 1,
        "mid": "0",
        "index": 0,
        "cand": "candidate:1 1 UDP 2122317823 127.0.0.1 50000 typ host",
        "from": 2
      },
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "candidate",
            "v": 1,
            "mid": "0",
            "index": 0,
            "cand": "candidate:1 1 UDP 2122317823 127.0.0.1 50000 typ host",
            "from": 1
          }
        }
      ]
    },
    {
      "from": "host",
      "send": {
        "t": "offer",
        "v": 1,
        "to": 1,
        "id": 2,
        "sdp": "v=0\r\no=- 1 2 IN IP4 127.0.0.1\r\ns=-\r\n",
        "ice_servers": [
          {
            "urls": [
              "turn:evil:3478"
            ]
          }
        ],
        "from": 9
      },
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "offer",
            "v": 1,
            "id": 2,
            "sdp": "v=0\r\no=- 1 2 IN IP4 127.0.0.1\r\ns=-\r\n",
            "ice_servers": [
              {
                "urls": [
                  "stun:stun.cloudflare.com:3478"
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
