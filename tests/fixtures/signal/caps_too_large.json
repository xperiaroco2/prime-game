{
  "about": "A message of 16384 bytes is read; one byte more is refused unread (JSON allows the padding spaces).",
  "config": {
    "ice_servers": [],
    "codes": [
      "ABCDEF"
    ]
  },
  "steps": [
    {
      "open": "host"
    },
    {
      "from": "host",
      "send": {
        "t": "open",
        "v": 1,
        "protocol": 7,
        "content": "0123456789abcdef",
        "max": 9
      },
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "room",
            "v": 1,
            "code": "ABCDEF",
            "ice_servers": []
          }
        }
      ]
    },
    {
      "open": "j1"
    },
    {
      "from": "j1",
      "send": {
        "t": "join",
        "v": 1,
        "code": "ABCDEF"
      },
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "found",
            "v": 1,
            "protocol": 7,
            "content": "0123456789abcdef"
          }
        },
        {
          "to": "host",
          "msg": {
            "t": "join",
            "v": 1,
            "from": 1
          }
        }
      ]
    },
    {
      "from": "j1",
      "raw": "{\"t\": \"answer\", \"v\": 1, \"sdp\": \"v=0\\r\\no=- 3 4 IN IP4 127.0.0.1\\r\\ns=-\\r\\n\"}",
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "answer",
            "v": 1,
            "sdp": "v=0\r\no=- 3 4 IN IP4 127.0.0.1\r\ns=-\r\n",
            "from": 1
          }
        }
      ],
      "pad_to": 16384
    },
    {
      "from": "j1",
      "raw": "{\"t\": \"answer\", \"v\": 1, \"sdp\": \"v=0\\r\\no=- 3 4 IN IP4 127.0.0.1\\r\\ns=-\\r\\n\"}",
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "error",
            "v": 1,
            "why": "too large"
          }
        }
      ],
      "pad_to": 16385
    }
  ]
}
