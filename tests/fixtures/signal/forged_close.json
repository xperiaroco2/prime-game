{
  "about": "A joiner's close: not allowed; the room stays open.",
  "config": {
    "ice_servers": [],
    "codes": [
      "ABCDEF"
    ]
  },
  "steps": [
    {
      "open": "host"
    },
    {
      "from": "host",
      "send": {
        "t": "open",
        "v": 1,
        "protocol": 7,
        "content": "0123456789abcdef",
        "max": 9
      },
      "expect": [
        {
          "to": "host",
          "msg": {
            "t": "room",
            "v": 1,
            "code": "ABCDEF",
            "ice_servers": []
          }
        }
      ]
    },
    {
      "open": "j1"
    },
    {
      "from": "j1",
      "send": {
        "t": "join",
        "v": 1,
        "code": "ABCDEF"
      },
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "found",
            "v": 1,
            "protocol": 7,
            "content": "0123456789abcdef"
          }
        },
        {
          "to": "host",
          "msg": {
            "t": "join",
            "v": 1,
            "from": 1
          }
        }
      ]
    },
    {
      "from": "j1",
      "send": {
        "t": "close",
        "v": 1
      },
      "expect": [
        {
          "to": "j1",
          "msg": {
            "t": "error",
            "v": 1,
            "why": "not allowed"
          }
        }
      ]
    },
    {
      "open": "j2"
    },
    {
      "from": "j2",
      "send": {
        "t": "join",
        "v": 1,
        "code": "ABCDEF"
      },
      "expect": [
        {
          "to": "j2",
          "msg": {
            "t": "found",
            "v": 1,
            "protocol": 7,
            "content": "0123456789abcdef"
          }
        },
        {
          "to": "host",
          "msg": {
            "t": "join",
            "v": 1,
            "from": 2
          }
        }
      ]
    }
  ]
}
