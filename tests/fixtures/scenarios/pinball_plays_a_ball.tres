[sub_resource type="Resource" id="Target_pinball"]
script = ExtResource("5_target")
kind = 5
station_kind = &"pinball"

[sub_resource type="Resource" id="Walk_to_the_machine"]
script = ExtResource("6_walk")
target = SubResource("Target_pinball")
stop_m = 0.0

[sub_resource type="Resource" id="Sit_down"]
script = ExtResource("7_interact")
station = SubResource("Target_pinball")
until = &"PinballState"

[sub_resource type="Resource" id="Expect_a_ball"]
script = ExtResource("8_expect")
event = &"PinballState"
fields = {
"in_play": true
}
within_s = 5.0

[sub_resource type="Resource" id="Press_left"]
script = ExtResource("10_flippers")
left = true

[sub_resource type="Resource" id="Release_left"]
script = ExtResource("10_flippers")

[sub_resource type="Resource" id="Press_right"]
script = ExtResource("10_flippers")
right = true

[sub_resource type="Resource" id="Expect_the_ball_lost"]
script = ExtResource("8_expect")
event = &"PinballState"
fields = {
"in_play": false
}
within_s = 5.0

[sub_resource type="Resource" id="Release_right"]
script = ExtResource("10_flippers")

[sub_resource type="Resource" id="Expect_the_next_ball"]
script = ExtResource("8_expect")
event = &"PinballState"
fields = {
"in_play": true
}
within_s = 5.0

[sub_resource type="Resource" id="Wait_past_the_seat_cooldown"]
script = ExtResource("11_wait")
seconds = 1.0

[sub_resource type="Resource" id="Stand_up"]
script = ExtResource("7_interact")
station = SubResource("Target_pinball")
until = &"PinballState"

[sub_resource type="Resource" id="Player_script"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Walk_to_the_machine"), SubResource("Sit_down"), SubResource("Expect_a_ball"), SubResource("Press_left"), SubResource("Release_left"), SubResource("Press_right"), SubResource("Expect_the_ball_lost"), SubResource("Release_right"), SubResource("Expect_the_next_ball"), SubResource("Wait_past_the_seat_cooldown"), SubResource("Stand_up")])

[sub_resource type="Resource" id="Watch_the_ball"]
script = ExtResource("9_wait_for")
event = &"PinballState"
fields = {
"in_play": true
}

[sub_resource type="Resource" id="Watch_it_lost"]
script = ExtResource("9_wait_for")
event = &"PinballState"
fields = {
"in_play": false
}

[sub_resource type="Resource" id="Watcher_script"]
script = ExtResource("3_script")
steps = Array[ExtResource("4_step")]([SubResource("Watch_the_ball"), SubResource("Watch_it_lost")])

[resource]
script = ExtResource("2_scen")
mode = ExtResource("1_mode")
session_seed = 151000000001
bots = 2
scripts = Array[ExtResource("3_script")]([SubResource("Player_script"), SubResource("Watcher_script")])
expected_ends = Array[StringName]([&"none"])
time_limit_s = 60.0
metadata/note = "A fixture scenario (#1510), provisional for the engineer to approve: bot 1 sits at the lobby's pinball, the bots' scripted table (ScriptedPinballTable) launches a ball, a left press hits the game's first target, a right press loses the ball, the next ball comes, bot 1 stands up; bot 2 watches, so both decode the public ball (LeakCheck.check_ball). No target id or number is written here."
