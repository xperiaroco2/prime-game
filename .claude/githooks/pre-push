#!/bin/sh
# Pre-push hook: a local copy of the server rules (docs/AGENT_WORKFLOW.md §8.3). `tools\run.cmd doctor` sets
# core.hooksPath to .claude/githooks. It blocks every push to main, every deletion of a remote ref and every
# non-fast-forward (force) update, with one exception: `tools\run.cmd publish` updates the current task branch
# <area>/<n>-<slug> with --force-with-lease after a rebase, and marks that push with
# PRIME_GAME_PUBLISH=force-with-lease (docs/decisions/2026-09-28-force-with-lease-on-task-branches.md).
# core.hooksPath switches off the hooks Git LFS installs in .git/hooks, so this hook runs `git lfs pre-push` itself.

input=$(cat)
branch=$(git symbolic-ref --quiet --short HEAD 2>/dev/null)
task_branch_re='^[a-z][a-z0-9]*/[0-9]+-[a-z0-9][a-z0-9._-]*$'
blocked=0

block() {
  printf 'pre-push: blocked %s\n  -> %s\n' "$1" "$2" >&2
  blocked=1
}

is_zero() {
  printf '%s' "$1" | grep -Eq '^0+$'
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "$remote_ref" ] || continue
  if is_zero "$local_oid"; then
    block "the deletion of $remote_ref" "Remote branches and tags are deleted by a human, on GitHub."
  elif [ "$remote_ref" = refs/heads/main ]; then
    block "a push to main" "Push the task branch and open a pull request: only humans merge into main."
  elif is_zero "$remote_oid" || git merge-base --is-ancestor "$remote_oid" "$local_oid" 2>/dev/null; then
    : # a new ref or a fast-forward
  elif [ "${PRIME_GAME_PUBLISH:-}" = force-with-lease ] && [ -n "$branch" ] \
    && [ "$remote_ref" = "refs/heads/$branch" ] && [ "$local_ref" = "refs/heads/$branch" ] \
    && printf '%s' "$branch" | grep -Eq "$task_branch_re"; then
    : # publish: the current task branch, rebased, with a lease
  else
    block "a force push (non-fast-forward update) of $remote_ref" \
      "Rebase and push the current task branch with: tools\\run.cmd publish (or tools/run.sh publish)."
  fi
done <<EOF
$input
EOF

[ "$blocked" -eq 0 ] || exit 1

if ! command -v git-lfs >/dev/null 2>&1; then
  printf '\npre-push: %s\n\n' "Git LFS is not installed, and this repository uses it. Install it (it comes with Git for Windows), then run: git lfs install --skip-repo" >&2
  exit 2
fi
[ -z "$input" ] || printf '%s\n' "$input" | git lfs pre-push "$@"
