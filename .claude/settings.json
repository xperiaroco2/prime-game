{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GH_PROMPT_DISABLED": "1"
  },
  "availableModels": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "workflowSizeGuideline": "small",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\" gd-edit",
            "timeout": 120,
            "statusMessage": "Checking GDScript"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tools/run.sh *)",
      "PowerShell(tools/run.sh *)",
      "Bash(./tools/run.sh *)",
      "PowerShell(./tools/run.sh *)",
      "PowerShell(tools\\run.cmd *)",
      "PowerShell(.\\tools\\run.cmd *)",
      "Bash(git fetch origin)",
      "PowerShell(git fetch origin)",
      "Bash(git fetch origin main)",
      "PowerShell(git fetch origin main)",
      "Bash(git fetch --prune origin)",
      "PowerShell(git fetch --prune origin)",
      "Bash(git add *)",
      "PowerShell(git add *)",
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git log *)",
      "PowerShell(git log *)",
      "Bash(git switch *)",
      "PowerShell(git switch *)",
      "Bash(git branch *)",
      "PowerShell(git branch *)",
      "Bash(git stash)",
      "PowerShell(git stash)",
      "Bash(git stash push *)",
      "PowerShell(git stash push *)",
      "Bash(git stash list*)",
      "PowerShell(git stash list*)",
      "Bash(git stash pop*)",
      "PowerShell(git stash pop*)",
      "Bash(git push -u origin *)",
      "PowerShell(git push -u origin *)",
      "Bash(git push origin *)",
      "PowerShell(git push origin *)",
      "Bash(gh issue view *)",
      "PowerShell(gh issue view *)",
      "Bash(gh issue list *)",
      "PowerShell(gh issue list *)",
      "Bash(gh issue comment *)",
      "PowerShell(gh issue comment *)",
      "Bash(gh issue create *)",
      "PowerShell(gh issue create *)",
      "Bash(gh issue edit *)",
      "PowerShell(gh issue edit *)",
      "Bash(gh issue close *)",
      "PowerShell(gh issue close *)",
      "Bash(gh issue reopen *)",
      "PowerShell(gh issue reopen *)",
      "Bash(gh pr view *)",
      "PowerShell(gh pr view *)",
      "Bash(gh pr list *)",
      "PowerShell(gh pr list *)",
      "Bash(gh pr checks *)",
      "PowerShell(gh pr checks *)",
      "Bash(gh pr diff *)",
      "PowerShell(gh pr diff *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(gh pr edit *)",
      "PowerShell(gh pr edit *)",
      "Bash(gh pr ready *)",
      "PowerShell(gh pr ready *)",
      "Bash(gh pr close *)",
      "PowerShell(gh pr close *)",
      "Bash(gh run list *)",
      "PowerShell(gh run list *)",
      "Bash(gh run view *)",
      "PowerShell(gh run view *)",
      "Bash(gh run watch *)",
      "PowerShell(gh run watch *)",
      "Bash(gh run rerun *)",
      "PowerShell(gh run rerun *)",
      "Bash(gh workflow list*)",
      "PowerShell(gh workflow list*)",
      "Bash(gh workflow view *)",
      "PowerShell(gh workflow view *)",
      "Bash(gh label *)",
      "PowerShell(gh label *)",
      "Bash(gh project *)",
