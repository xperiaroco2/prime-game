{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GH_PROMPT_DISABLED": "1"
  },
  "availableModels": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "workflowSizeGuideline": "small",
  "skillOverrides": {
    "artifact-capabilities": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "artifact-diagramming": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "code-review": "user-invocable-only",
    "dataviz": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "init": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "loop": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "run": "user-invocable-only",
    "schedule": "user-invocable-only",
    "security-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "update-config": "user-invocable-only"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\" guard",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/run-hook.sh\" gd-edit",
            "timeout": 120,
            "statusMessage": "Checking GDScript"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(tools/run.sh *)",
      "PowerShell(tools/run.sh *)",
      "Bash(./tools/run.sh *)",
      "PowerShell(./tools/run.sh *)",
